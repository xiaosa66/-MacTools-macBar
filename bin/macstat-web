<script>
const MAXPTS = 600, COLD="#f85149", CYAN="#39c5cf", OK="#3fb950", GRID="#21262d", DIM="#8b949e";
const H = [], IW = [], SW = [];
const cv = document.getElementById('cv'), ctx = cv.getContext('2d');
let lastOK = 0;

function fitCanvas(){
  const r = window.devicePixelRatio || 1;
  cv.width = cv.clientWidth * r; cv.height = cv.clientHeight * r;
  ctx.setTransform(r,0,0,r,0,0);
}

function push(arr, v){ arr.push(v); if (arr.length > MAXPTS) arr.shift(); }

function fmtMin(m){ if(!m||m>=65535) return '估算中';
  return m>=60 ? Math.floor(m/60)+'h'+String(m%60).padStart(2,'0')+'m' : m+' 分钟'; }

function draw(){
  const w = cv.clientWidth, h = cv.clientHeight, pl = 42, pr = 44, pt = 8, pb = 18;
  ctx.clearRect(0,0,w,h);
  const iw = w-pl-pr, ih = h-pt-pb;
  // 温度轴 20~105，功率轴 0~50
  const lo=20, hi=105, plo=0, phi=50;
  ctx.strokeStyle=GRID; ctx.lineWidth=1; ctx.fillStyle=DIM;
  ctx.font='10px ui-monospace,Menlo,monospace';
  for(let i=0;i<=4;i++){
    const y = pt + ih*i/4;
    ctx.beginPath(); ctx.moveTo(pl,y); ctx.lineTo(pl+iw,y); ctx.stroke();
    ctx.textAlign='right'; ctx.fillStyle=COLD;
    ctx.fillText((hi-(hi-lo)*i/4).toFixed(0)+'°', pl-6, y+3);
    ctx.textAlign='left'; ctx.fillStyle=OK;
    ctx.fillText((phi-(phi-plo)*i/4).toFixed(0)+'W', pl+iw+6, y+3);
  }
  if(H.length<2){ return; }
  const n = H.length, step = iw/(MAXPTS-1), x0 = pl + iw - (n-1)*step;
  function line(arr,axis,color,width){
    ctx.beginPath();
    let started=false;
    for(let k=0;k<n;k++){
      const v = arr[k]; if(v==null) continue;
      let y;
      if(axis==='t'){ y = pt + ih*(1-(Math.min(v,hi)-lo)/(hi-lo)); }
      else { y = pt + ih*(1-(Math.min(v,phi)-plo)/(phi-plo)); }
      const x = x0 + k*step;
      if(!started){ ctx.moveTo(x,y); started=true; } else ctx.lineTo(x,y);
    }
    ctx.strokeStyle=color; ctx.lineWidth=width||1.6; ctx.lineJoin='round'; ctx.stroke();
  }
  line(H,'t',COLD); line(IW,'p',CYAN); line(SW,'p',OK,1.2);
}

function set(id,v){ const e=document.getElementById(id); if(e) e.innerHTML=v; }

function setVal(id,v,unit,color){
  const e=document.getElementById(id);
  e.innerHTML = (v==null?'—':v)+'<small>'+unit+'</small>';
  e.style.color = color || 'var(--fg)';
}

function tick(){
  fetch('/api/status').then(r=>r.json()).then(d=>{
    lastOK = Date.now();
    document.getElementById('dot').className='dot';
    document.getElementById('beat').textContent='实时 · '+new Date().toLocaleTimeString('zh-CN');

    const s = d.soc||{}, p = d.power||{};
    // 温度
    const t = s.cpu_temp;
    setVal('temp', t, '°C', t>=85?'var(--hot)':(t>=65?'var(--warn)':'var(--ok)'));
    set('temp-sub', (t>=90?'降频区':(t>=70?'偏高':'正常')) + (s.gpu_temp? ' · GPU '+s.gpu_temp.toFixed(0)+'°':''));
    // 取电
    if(p.on_ac && p.in_w>0){
      setVal('inw', p.in_w.toFixed(1), 'W', 'var(--ok)');
      const parts=[];
      if(p.sys_w>0) parts.push('负载 '+p.sys_w.toFixed(1)+'W');
      if(Math.abs(p.batt_w)>0.05) parts.push((p.batt_w>0?'充电 ':'放电 ')+Math.abs(p.batt_w).toFixed(1)+'W');
      if(p.loss_w>0) parts.push('损耗 '+p.loss_w.toFixed(1)+'W');
      set('inw-sub', parts.join(' + ') + ' · ' + p.in_v.toFixed(1)+'V/'+p.in_a.toFixed(2)+'A');
    } else {
      setVal('inw','—','','var(--dim)');
      set('inw-sub', p.on_ac? '读数刷新中' : '电池供电 · 无取电');
    }
    // SoC
    setVal('socw', s.soc_w!=null? s.soc_w.toFixed(1):null, 'W', 'var(--ok)');
    set('socw-sub', 'macmon 口径');
    // 电池
    if(p.soc!=null){
      let st, col='var(--fg)';
      if(p.fully_charged){ st='已充满'; col='var(--ok)'; }
      else if(p.charging){ st='↑ 充电 · '+fmtMin(p.eta_min)+'后满'; col='var(--ok)'; }
      else if(p.on_ac){ st='→ 已接电未充'; }
      else { st='↓ 放电 · 可用 '+fmtMin(p.eta_min); col='var(--warn)'; }
      setVal('soc', p.soc, '%', col);
      set('soc-sub', st);
      document.getElementById('socbar').style.width = p.soc+'%';
      document.getElementById('socbar').style.background = col;
    }
    // 频率
    setVal('freq', (s.pcpu_mhz/1000).toFixed(2), 'GHz');
    set('freq-sub','p核 · e核 '+(s.ecpu_mhz/1000).toFixed(2)+'GHz · 占用 '+s.cpu_pct+'%');
    // 内存
    setVal('mem', s.ram_used, 'GB');
    const mpct = s.ram_total? (s.ram_used/s.ram_total*100):0;
    set('mem-sub','/ '+s.ram_total+' GB · '+mpct.toFixed(0)+'% · swap '+s.swap_used+'/'+s.swap_total+' GB');
    document.getElementById('membar').style.width = mpct+'%';
    document.getElementById('membar').style.background = mpct>85?'var(--hot)':'var(--accent)';
    // 图例 & 序列
    set('lg-t', t!=null? t.toFixed(1):'—');
    set('lg-i', p.on_ac? p.in_w.toFixed(1):'—');
    set('lg-s', s.soc_w!=null? s.soc_w.toFixed(1):'—');
    push(H, t); push(IW, p.on_ac? p.in_w : null); push(SW, s.soc_w);
    draw();
    // 页脚
    set('misc',
      (p.on_ac? 'PD 档 '+(p.pd_volt||0).toFixed(1)+'V/'+(p.pd_amp||0).toFixed(1)+'A · 适配器 '+(p.adapter_w||'?')+'W'
              : '电池供电') +
      ' · 循环 '+(p.cycles||'?') + ' · 健康 '+(p.health? p.health.toFixed(0)+'%':'?') +
      ' · GPU '+(s.gpu_mhz||0)+'MHz');
    if(d.error){ document.getElementById('beat').textContent = '采样异常: '+d.error;
                 document.getElementById('dot').className='dot bad'; }
  }).catch(e=>{
    document.getElementById('dot').className='dot bad';
    document.getElementById('beat').textContent='采样中断，重连中…';
  });
}

window.addEventListener('resize', ()=>{ fitCanvas(); draw(); });
fetch('/api/model').then(r=>r.json()).then(d=>set('model', d.model)).catch(()=>{});
fitCanvas(); tick(); setInterval(tick, 1000);
</script>
</body>
</html>
"""


def machine_model():
    try:
        out = subprocess.run(
            ["sysctl", "-n", "machdep.cpu.brand_string"], capture_output=True, text=True
        ).stdout.strip()
        hw = subprocess.run(
            ["sysctl", "-n", "hw.model"], capture_output=True, text=True
        ).stdout.strip()
        return hw or out or "Mac"
    except Exception:
        return "Mac"


def make_handler(sampler, interval_ms):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path.startswith("/api/status"):
                snap = sampler.snapshot()
                snap["interval_ms"] = interval_ms
                body = json.dumps(snap, ensure_ascii=False).encode()
                self._send(200, body, "application/json; charset=utf-8")
            elif self.path.startswith("/api/model"):
                body = json.dumps({"model": MACHINE_MODEL}, ensure_ascii=False).encode()
                self._send(200, body, "application/json; charset=utf-8")
            elif self.path in ("/", "/index.html"):
                self._send(200, PAGE.encode(), "text/html; charset=utf-8")
            else:
                self._send(404, b"not found", "text/plain")

    return Handler


MACHINE_MODEL = ""


def main():
    ap = argparse.ArgumentParser(prog="macstat-web", description="Mac 实时状态面板")
    ap.add_argument("--port", type=int, default=8787)
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--interval", type=int, default=1000, help="采样间隔毫秒（默认 1000）")
    ap.add_argument("--no-open", action="store_true", help="不自动打开浏览器")
    args = ap.parse_args()

    global MACHINE_MODEL
    MACHINE_MODEL = machine_model()
    interval = max(1000, args.interval)

    if not os.path.exists(MACMON):
        sys.exit("macstat-web: 找不到 %s，SoC 温度/功耗将不可用" % MACMON)

    sampler = Sampler(interval)
    sampler.start()
    for _ in range(40):  # 等首帧
        if sampler.snapshot()["soc"]:
            break
        time.sleep(0.25)

    handler = make_handler(sampler, interval)
    srv = ThreadingHTTPServer((args.host, args.port), handler)
    url = "http://127.0.0.1:%d/" % args.port

    print("macstat-web · %s" % MACHINE_MODEL)
    print("面板地址: %s   采样间隔 %dms   Ctrl-C 退出" % (url, interval))

    def shutdown(signum, frame):
        print("\n正在停止…")
        sampler.stop()
        threading.Thread(target=srv.shutdown, daemon=True).start()

    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGTERM, shutdown)

    if not args.no_open:
        subprocess.Popen(["open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        sampler.stop()


if __name__ == "__main__":
    main()
