#!/usr/bin/env python3
"""macstat-web — Mac 实时状态面板（本地网页）

后台常驻采样两个数据源：
  - macmon（免 sudo）：CPU 温度 / SoC 包功耗 / 频率 / 内存 / GPU
  - ioreg AppleSmartBattery（免 sudo）：PD 协商档 / 整机取电功率 / 电池状态
然后起一个本地 HTTP 服务，浏览器打开即可看实时曲线。

用法:
    macstat-web              # 默认 http://127.0.0.1:8787 并自动打开浏览器
    macstat-web --port 9000
    macstat-web --interval 2000        # 采样间隔毫秒
    macstat-web --no-open              # 不起浏览器
    macstat-web --host 0.0.0.0         # 允许局域网访问（慎用）

Ctrl-C 退出。
"""

import argparse
import json
import os
import plistlib
import signal
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

MACMON = os.path.expanduser("~/.local/bin/macmon")
GB = 1024 ** 3
MAX_PLAUSIBLE_W = 100
POWER_TTL = 5.0  # ioreg 底层读数就是这个更新量级，读更快没有新信息


# ---------------------------------------------------------------- 电源采集
# 与 ~/scripts/macstat 同源，此处保留独立副本：Web 是常驻进程，
# 不应被 CLI 脚本的编辑牵连。


def read_power():
    try:
        raw = subprocess.run(
            ["ioreg", "-r", "-c", "AppleSmartBattery", "-a", "-w0"],
            capture_output=True,
            timeout=15,
        ).stdout
        node = plistlib.loads(raw)[0]
    except Exception:
        return None

    tel = node.get("PowerTelemetryData") or {}
    ad = node.get("AdapterDetails") or {}
    bd = node.get("BatteryData") or {}
    full = bd.get("FullChargeCapacity") or 0
    design = bd.get("DesignCapacity") or 0

    def w(key):
        return round((tel.get(key) or 0) / 1000.0, 1)

    return {
        "on_ac": bool(node.get("ExternalConnected")),
        "charging": bool(node.get("IsCharging")),
        "fully_charged": bool(node.get("FullyCharged")),
        "soc": node.get("CurrentCapacity"),
        "cycles": node.get("CycleCount"),
        "full_mah": full,
        "design_mah": design,
        "health": round(full * 100.0 / design, 1) if design and full else None,
        "eta_min": node.get("AvgTimeToFull") or node.get("AvgTimeToEmpty") or 0,
        "adapter_w": ad.get("Watts") or None,
        "pd_volt": round((ad.get("AdapterVoltage") or 0) / 1000.0, 2),
        "pd_amp": round((ad.get("Current") or 0) / 1000.0, 2),
        "in_v": round((tel.get("SystemVoltageIn") or 0) / 1000.0, 2),
        "in_a": round((tel.get("SystemCurrentIn") or 0) / 1000.0, 2),
        "in_w": w("SystemPowerIn"),
        "sys_w": w("SystemLoad"),
        "batt_w": w("BatteryPower"),
        "loss_w": w("AdapterEfficiencyLoss"),
    }


# ------------------------------------------------------------------ 采样器


class Sampler(threading.Thread):
    """常驻的 macmon + ioreg 采样线程。"""

    def __init__(self, interval_ms):
        super().__init__(daemon=True)
        self.interval = max(1000, interval_ms)
        self.lock = threading.Lock()
        self.soc = {}
        self.power = None
        self.power_ts = 0.0
        self.error = None
        self._stop = threading.Event()
        self._proc = None

    def stop(self):
        self._stop.set()
        if self._proc and self._proc.poll() is None:
            self._proc.terminate()

    def _pump(self):
        self._proc = subprocess.Popen(
            [MACMON, "pipe", "-i", str(self.interval)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        for line in self._proc.stdout:
            if self._stop.is_set():
                break
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                row = json.loads(line)
            except ValueError:
                continue
            p = row.get("sys_power") or 0
            mem = row.get("memory") or {}
            temp = row.get("temp") or {}
            soc = {
                "ts": time.time(),
                "cpu_temp": round(temp.get("cpu_temp_avg") or 0, 1),
                "gpu_temp": round(temp.get("gpu_temp_avg") or 0, 1),
                "soc_w": round(p, 1) if 0 < p < MAX_PLAUSIBLE_W else None,
                "pcpu_mhz": row.get("pcpu_freq_mhz") or 0,
                "ecpu_mhz": row.get("ecpu_freq_mhz") or 0,
                "gpu_mhz": row.get("gpu_freq_mhz") or 0,
                "cpu_pct": round((row.get("cpu_usage_pct") or 0) * 100, 1),
                "ram_used": round(mem.get("ram_usage", 0) / GB, 2),
                "ram_total": round(mem.get("ram_total", 0) / GB, 2),
                "swap_used": round(mem.get("swap_usage", 0) / GB, 2),
                "swap_total": round(mem.get("swap_total", 0) / GB, 2),
            }
            with self.lock:
                self.soc = soc
                self.error = None

    def run(self):
        while not self._stop.is_set():
            try:
                self._pump()
            except FileNotFoundError:
                self.error = "找不到 %s" % MACMON
                return
            except Exception as exc:  # macmon 崩了就重启
                self.error = str(exc)
            if self._stop.is_set():
                break
            time.sleep(1.0)

    def _refresh_power(self):
        if time.time() - self.power_ts < POWER_TTL:
            return
        p = read_power()
        if p is not None:
            with self.lock:
                self.power = p
                self.power_ts = time.time()

    def snapshot(self):
        self._refresh_power()
        with self.lock:
            return {"soc": dict(self.soc), "power": self.power, "error": self.error}


# ------------------------------------------------------------------- HTTP


PAGE = r"""<!DOCTYPE html>
