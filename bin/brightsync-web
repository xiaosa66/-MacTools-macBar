  button.act{background:#21262d;color:var(--fg);border:1px solid var(--line);border-radius:7px;
             padding:6px 12px;font-size:12.5px;cursor:pointer}
  button.act:hover{border-color:#484f58;background:#2d333b}
  button.act.primary{background:#238636;border-color:#2ea043;color:#fff}
  button.act:disabled{opacity:.45;cursor:default}
  svg{display:block;touch-action:none;cursor:crosshair;width:100%;height:auto}
  .hint{font-size:12px;color:var(--dim);margin-top:6px}
  .hint.warn{color:var(--warn);margin:0;font-size:12px}
  .hint.done{color:var(--ok);margin:0;font-size:12px}
  .pill{font-size:11.5px;padding:2px 9px;border-radius:20px;border:1px solid var(--line);color:var(--dim)}
  .pill.ok{color:var(--ok);border-color:#238636;background:rgba(63,185,80,.12)}
  .pill.off{color:var(--warn);border-color:#5c4813;background:rgba(210,153,34,.1)}
  footer{margin-top:18px;color:var(--dim);font-size:12px;border-top:1px solid var(--line);padding-top:12px}
  code{background:#1c2128;padding:1px 6px;border-radius:4px;font-size:12px}
  input[type=number]{background:#0d1117;border:1px solid var(--line);color:var(--fg);border-radius:6px;
                     padding:3px 7px;width:66px;font:12.5px ui-monospace,Menlo,monospace}
</style></head><body>

<h1>外接屏亮度跟随</h1>
<p class="lead">内建屏亮度变化 → 按映射曲线同步到外接显示器。走系统原生亮度通道，真背光。</p>

