#!/usr/bin/env python3
"""brightsync-web — 外接屏亮度跟随的控制面板

一个页面搞定：实时看内建/外接亮度、开关跟随、拖锚点调映射曲线。
跟随逻辑仍在 brightsync watch 进程里，本服务只负责「看」和「改配置」，
配置改完 watch 会在 0.5 秒内自动重载。

用法:
    brightsync-web                  # http://127.0.0.1:8766
    brightsync-web --port 9000
    brightsync-web --no-open
"""

import argparse
import json
import os
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

import brightsync_core as core  # noqa: E402

PY = "/usr/bin/python3" if os.path.exists("/usr/bin/python3") else sys.executable
WATCH_SCRIPT = os.path.join(ROOT, "bin", "brightsync")

_LOCK = threading.Lock()


def start_watch():
    """拉起后台跟随进程（不占端口），返回 (ok, msg)。"""
    pid = core.watch_pid()
    if pid:
        return True, "已在运行 pid=%d" % pid
    with open(core.LOG_PATH, "a", encoding="utf-8") as log:
        subprocess.Popen(
            [PY, WATCH_SCRIPT, "watch"],
            stdout=log, stderr=log,
            start_new_session=True,
        )
    for _ in range(20):
        time.sleep(0.1)
        if core.watch_pid():
            return True, "已启动"
    return False, "启动超时，见 ~/Library/Logs/brightsync.log"


def stop_watch():
    """发 SIGTERM；僵尸由 core._alive 里的 waitpid 顺手回收。"""
    pid = core.watch_pid()
    if not pid:
        return True, "本来就没在跑"
    try:
        os.kill(pid, 15)
    except OSError as e:
        return False, str(e)
    for _ in range(20):
        time.sleep(0.1)
        if not core.watch_pid():
            return True, "已停止"
    return False, "进程没有响应 SIGTERM"


class Handler(BaseHTTPRequestHandler):
    server_version = "brightsync-web"

    def log_message(self, fmt, *args):
        pass  # 静默，避免刷屏

    # ---------------------------------------------------------- 响应工具

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        raw = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def _json(self, data, code=200):
        self._send(code, json.dumps(data, ensure_ascii=False))

    def _body(self):
        try:
            n = int(self.headers.get("Content-Length") or 0)
            if n <= 0:
                return {}
            return json.loads(self.rfile.read(n).decode("utf-8"))
        except (ValueError, OSError):
            return {}

    # -------------------------------------------------------------- 路由

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if self.path.startswith("/api/status"):
            return self._json(core.state())
        return self._json({"error": "not found"}, 404)

    def do_POST(self):
        if self.path.startswith("/api/toggle"):
            body = self._body()
            with _LOCK:
                cfg = core.load_config()
                cfg["enabled"] = bool(body.get("enabled", not cfg["enabled"]))
                core.save_config(cfg)
            return self._json(core.state())

        if self.path.startswith("/api/config"):
            body = self._body()
            with _LOCK:
                cfg = core.load_config()
                try:
                    if "anchors" in body:
                        pts = sorted((float(a), float(b)) for a, b in body["anchors"])
                        if len(pts) < 2:
                            raise ValueError("至少需要两个锚点")
                        if pts[0][0] > 0 or pts[-1][0] < 100:
                            raise ValueError("锚点必须覆盖 0% 和 100%")
                        cfg["anchors"] = pts
                    for k in ("deadband", "minStep", "interval"):
                        if k in body:
                            cfg[k] = float(body[k])
                    if "clamp" in body:
                        lo, hi = float(body["clamp"][0]), float(body["clamp"][1])
                        cfg["clamp"] = [lo, hi]
                except (TypeError, ValueError) as e:
                    return self._json({"ok": False, "error": str(e)}, 400)
                core.save_config(cfg)
            return self._json({"ok": True, "state": core.state()})

        if self.path.startswith("/api/sync"):
            ok, internal, target, _ = core.sync_once(dry=True)
            return self._json({"ok": ok, "internal": internal, "target": target})

        if self.path.startswith("/api/daemon"):
            action = (self._body().get("action") or "").strip()
            if action == "start":
                ok, msg = start_watch()
            elif action == "stop":
                ok, msg = stop_watch()
            else:
                return self._json({"ok": False, "error": "action 需为 start/stop"}, 400)
            return self._json({"ok": ok, "msg": msg, "state": core.state()})

        return self._json({"error": "not found"}, 404)


PAGE = r"""<!DOCTYPE html>
