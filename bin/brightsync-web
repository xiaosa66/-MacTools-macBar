<script>
const $ = id => document.getElementById(id);
const NS = 'http://www.w3.org/2000/svg';
const W = 340, H = 300, PAD = 34;
let ST = null, anchors = null, dirty = false, dragIdx = -1;

const sx = v => PAD + (v / 100) * (W - PAD - 12);
const sy = v => H - PAD - (v / 100) * (H - PAD - 14);

// 网格刻度是固定的，只建一次
(function initGrid(){
  let s = '';
  for(let v = 0; v <= 100; v += 25){
    s += `<line x1="${sx(v)}" y1="${sy(0)}" x2="${sx(v)}" y2="${sy(100)}" stroke="#21262d"/>`;
    s += `<line x1="${sx(0)}" y1="${sy(v)}" x2="${sx(100)}" y2="${sy(v)}" stroke="#21262d"/>`;
    s += `<text x="${sx(v)}" y="${sy(0)+16}" fill="#8b949e" font-size="10" text-anchor="middle">${v}</text>`;
    s += `<text x="${sx(0)-8}" y="${sy(v)+3}" fill="#8b949e" font-size="10" text-anchor="end">${v}</text>`;
  }
  $('gGrid').innerHTML = s;
  const ref = $('lRef');
  ref.setAttribute('x1', sx(0)); ref.setAttribute('y1', sy(0));
  ref.setAttribute('x2', sx(100)); ref.setAttribute('y2', sy(100));
})();

// 锚点元素复用，绝不重建 —— 重建会让正在拖的圆点失去 pointer capture，
// 表现就是「拖到一半被刷新打断」。
const dotEls = [];
function dotAt(i){
  if(dotEls[i]) return dotEls[i];
  const c = document.createElementNS(NS, 'circle');
  c.setAttribute('r', 7);
  c.setAttribute('fill', '#161b22');
  c.setAttribute('stroke', '#58a6ff');
  c.setAttribute('stroke-width', 2);
  c.style.cursor = 'grab';
  c.addEventListener('pointerdown', e=>{
    e.preventDefault();
    dragIdx = i;
    c.setPointerCapture(e.pointerId);
    c.style.cursor = 'grabbing';
  });
  const t = document.createElementNS(NS, 'text');
  t.setAttribute('fill', '#58a6ff');
  t.setAttribute('font-size', '10');
  $('gAnchors').appendChild(c);
  $('gAnchors').appendChild(t);
  return (dotEls[i] = {c, t});
}

function syncDots(){
  for(let i = dotEls.length - 1; i >= 0; i--){
    if(i >= anchors.length){
      dotEls[i].c.remove(); dotEls[i].t.remove(); dotEls.splice(i, 1);
    }
  }
  anchors.forEach((a, i)=>{
    const {c, t} = dotAt(i);
    const cx = sx(a[0]), cy = sy(a[1]);
    c.setAttribute('cx', cx); c.setAttribute('cy', cy);
    t.setAttribute('x', cx);
    t.setAttribute('y', Math.max(10, cy - 12));
    t.setAttribute('text-anchor', cx > W - 46 ? 'end' : (cx < 46 ? 'start' : 'middle'));
    t.textContent = Math.round(a[1]);
  });
}

// 前端算一份映射，拖锚点时工作点即时跟着走，不等服务端
function localMap(x){
  const p = anchors;
  if(!p || !p.length) return x;
  if(x <= p[0][0]) return p[0][1];
  if(x >= p[p.length-1][0]) return p[p.length-1][1];
  for(let i = 0; i < p.length - 1; i++){
    const [x0,y0] = p[i], [x1,y1] = p[i+1];
    if(x0 <= x && x <= x1){
      const sp = x1 - x0;
      return sp <= 0 ? y0 : y0 + (y1 - y0) * (x - x0) / sp;
    }
  }
  return x;
}

function draw(){
  if(!anchors) return;
  $('pLine').setAttribute('points', anchors.map(a=>`${sx(a[0])},${sy(a[1])}`).join(' '));
  const wg = $('gWork');
  const bx = ST && ST.builtin.brightness;
  if(bx != null){
    const lo = parseFloat($('pLo').value) || 0;
    const by = Math.max(lo, Math.min(100, localMap(bx)));
    $('cWork').setAttribute('cx', sx(bx)); $('cWork').setAttribute('cy', sy(by));
    $('lWork').setAttribute('x1', sx(bx)); $('lWork').setAttribute('x2', sx(bx));
    $('lWork').setAttribute('y1', sy(0));  $('lWork').setAttribute('y2', sy(by));
    wg.style.display = '';
  } else {
    wg.style.display = 'none';
  }
  syncDots();
}

function toData(e){
  const r = $('curve').getBoundingClientRect();
  const px = (e.clientX - r.left) / r.width * W;
  const py = (e.clientY - r.top) / r.height * H;
  return [
    Math.max(0, Math.min(100, (px - PAD) / (W - PAD - 12) * 100)),
    Math.max(0, Math.min(100, (H - PAD - py) / (H - PAD - 14) * 100)),
  ];
}

$('curve').addEventListener('pointermove', e=>{
  if(dragIdx < 0) return;
  const [x,y] = toData(e);
  const a = anchors[dragIdx];
  // 首尾锚点锁 x（必须覆盖 0/100），中间锚点限制在相邻之间
  if(dragIdx === 0 || dragIdx === anchors.length - 1){
    a[1] = Math.round(y);
  } else {
    const lo = anchors[dragIdx-1][0] + 1, hi = anchors[dragIdx+1][0] - 1;
    a[0] = Math.round(Math.max(lo, Math.min(hi, x)));
    a[1] = Math.round(y);
  }
  markDirty();
  draw();
});
['pointerup','pointercancel'].forEach(ev=>$('curve').addEventListener(ev, e=>{
  if(dragIdx >= 0 && dotEls[dragIdx]) dotEls[dragIdx].c.style.cursor = 'grab';
  dragIdx = -1;
}));

// ------------------------------------------------ 未保存状态
function setHint(text, cls){
  const el = $('saveHint');
  el.textContent = text || '';
  el.className = 'hint' + (cls ? ' ' + cls : '');
}

function markDirty(){
  if(dirty) return;
  dirty = true;
  $('saveBtn').disabled = false;
  $('revertBtn').disabled = false;
  setHint('未保存', 'warn');
}

function clearDirty(){
  dirty = false;
  $('saveBtn').disabled = true;
  $('revertBtn').disabled = true;
}

function applyConfig(c){
  anchors = c.anchors.map(a=>[a[0], a[1]]);
  $('pDead').value = c.deadband;
  $('pStep').value = c.minStep;
  $('pInt').value = c.interval;
  $('pLo').value = c.clamp[0];
  draw();
}

function preset(kind){
  if(kind === 'even') anchors = [[0,0],[100,100]];
  if(kind === 'dimmer') anchors = [[0,0],[25,18],[50,40],[75,68],[100,100]];
  if(kind === 'night') anchors = [[0,0],[25,10],[50,25],[75,45],[100,70]];
  markDirty();
  draw();
}

function render(){
  if(!ST) return;
  const s = ST;
  $('sw').classList.toggle('on', s.enabled);
  $('flags').innerHTML = s.enabled
    ? '<span class="pill ok">跟随中</span>'
    : '<span class="pill off">已暂停</span>';

  const inB = s.builtin.brightness;
  $('inVal').textContent = inB == null ? '—（内建屏不可用）' : inB.toFixed(1) + '%';
  $('inBar').style.width = (inB || 0) + '%';

  if(s.external.length){
    const e = s.external[0];
    $('exVal').textContent = (e.current == null ? '—' : e.current.toFixed(1) + '%')
      + '  /  ' + (e.mapped == null ? '—' : e.mapped.toFixed(1) + '%');
    $('exBar').style.width = (e.current || 0) + '%';
  } else {
    $('exVal').textContent = '未检测到外接屏';
    $('exBar').style.width = '0%';
  }

  $('dpid').textContent = s.watching ? '跟随进程：运行中 pid=' + s.pid : '跟随进程：未运行';
  const btn = $('dBtn');
  btn.textContent = s.watching ? '停止进程' : '启动进程';
  btn.classList.toggle('primary', !s.watching);

  // 有未保存改动时绝不回写表单，否则输入框会被轮询冲掉
  if(!dirty) applyConfig(s.config);
  draw();
}

async function refresh(){
  if(dragIdx >= 0) return;  // 拖动中不打断
  try{
    const r = await fetch('/api/status', {cache:'no-store'});
    ST = await r.json();
    if(ST.paths && ST.paths.config) $('cfgPath').textContent = ST.paths.config;
    render();
  }catch(e){}
}

async function toggle(){
  $('sw').disabled = true;
  await fetch('/api/toggle', {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({enabled: !ST.enabled})});
  $('sw').disabled = false;
  refresh();
}

async function toggleDaemon(){
  const btn = $('dBtn'); btn.disabled = true;
  await fetch('/api/daemon', {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({action: ST.watching ? 'stop' : 'start'})});
  setTimeout(()=>{ btn.disabled = false; refresh(); }, 700);
}

function revert(){
  clearDirty();
  setHint('已还原', '');
  if(ST) applyConfig(ST.config);
}

async function save(){
  for(const [id, name] of [['pDead','响应阈值'],['pStep','最小步进'],['pInt','轮询间隔'],['pLo','外接下限']]){
    const v = parseFloat($(id).value);
    if(!isFinite(v)){ alert('「' + name + '」不是有效数字'); $(id).focus(); return; }
  }
  const hi = (ST && ST.config && ST.config.clamp) ? ST.config.clamp[1] : 100;
  const body = {
    anchors: anchors,
    deadband: parseFloat($('pDead').value),
    minStep: parseFloat($('pStep').value),
    interval: parseFloat($('pInt').value),
    clamp: [parseFloat($('pLo').value), hi],
  };
  $('saveBtn').disabled = true;
  const r = await fetch('/api/config', {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify(body)});
  const d = await r.json();
  if(d.ok){
    ST = d.state;
    clearDirty();
    applyConfig(ST.config);
    setHint('已保存', 'done');
  } else {
    $('saveBtn').disabled = false;
    setHint('未保存', 'warn');
    alert('保存失败：' + (d.error || '未知错误'));
  }
}

window.addEventListener('beforeunload', e=>{
  if(dirty){ e.preventDefault(); e.returnValue = ''; }
});

refresh();
setInterval(refresh, 1500);
</script>
</body></html>
"""


def main():
    ap = argparse.ArgumentParser(prog="brightsync-web", description="外接屏亮度跟随控制面板")
    ap.add_argument("--port", type=int, default=8766)
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--no-open", action="store_true")
    args = ap.parse_args()

    srv = ThreadingHTTPServer((args.host, args.port), Handler)
    url = "http://%s:%d/" % (args.host, args.port)
    print("brightsync 面板: %s   Ctrl-C 退出" % url, flush=True)
    if not args.no_open:
        subprocess.Popen(["open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n已退出", flush=True)
    finally:
        srv.server_close()


if __name__ == "__main__":
    main()
