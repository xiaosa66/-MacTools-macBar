        --accent:#58a6ff;--ok:#3fb950;--warn:#d29922;--hot:#f85149}
  *{box-sizing:border-box}
  body{margin:0 auto;background:var(--bg);color:var(--fg);padding:24px;max-width:760px;
       font:14px/1.55 -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
