    <polyline id="pLine" fill="none" stroke="#58a6ff" stroke-width="2.5" stroke-linejoin="round"/>
    <g id="gWork"><line id="lWork" stroke="#3fb950" stroke-width="1" stroke-dasharray="3 3" opacity=".7"/>
      <circle id="cWork" r="4" fill="#3fb950"/></g>
    <g id="gAnchors"></g>
  </svg>
  <div class="hint">横轴 = 内建屏亮度，纵轴 = 外接屏亮度。拖动圆点调整；两点之间的连线是实际映射。</div>
